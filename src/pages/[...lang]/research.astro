---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { langPaths, nav, pageUrl, t, ui, withBase, type CardModalPayload, type Lang } from '../../i18n/ui';
import { research } from '../../data/research';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = t(nav.find((n) => n.page === 'research')!.label, lang);
const L = {
  sub: {
    zh: '半導體材料 → 覆晶封裝 → 光學設計 → 智慧物聯網 → 電子量測',
    en: 'Semiconductor Materials → Flip-Chip Packaging → Optical Design → AIoT Systems → Electronic Metrology',
    ja: '半導体材料 → フリップチップ実装 → 光学設計 → スマートAIoT → 電子計測',
  },
  key: { zh: '關鍵技術', en: 'Key Technologies', ja: '主要技術' },
  app: { zh: '應用領域', en: 'Applications', ja: '応用分野' },
  thesesTitle: { zh: '🎓 歷屆學長姐代表學位論文', en: '🎓 Representative Theses by Lab Alumni', ja: '🎓 先輩方の代表修士論文' },
  viewMembers: { zh: '查看所有歷屆碩士生論文介紹', en: 'View All Alumni Theses on Members Page', ja: 'メンバーページで全修士論文を見る' },
  viewEquip: { zh: '查看實驗室對應機台設備', en: 'View Related Lab Equipment', ja: '関連する実験設備を見る' },
};
---

<Base lang={lang} page="research" title={title}>
  <section class="page-hero">
    <div class="container">
      <h1>{title}</h1>
      <p>{t(L.sub, lang)}</p>
      <div class="jump">
        {
          research.map((r) => (
            <a href={`#${r.id}`}>
              {r.icon} {t(r.title, lang)}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    research.map((r, i) => {
      const areaModalData: CardModalPayload = {
        icon: r.icon,
        badge: `0${i + 1} · ${title}`,
        title: t(r.title, lang),
        image: withBase(r.image),
        desc: t(r.summary, lang),
        sections: [
          { title: t(L.key, lang), list: r.points.map((p) => t(p, lang)) },
          ...(r.theses?.length
            ? [
                {
                  title: t(L.thesesTitle, lang),
                  cards: r.theses.map((th) => ({
                    title: t(th.title, lang),
                    meta: `${t(th.student, lang)}${th.year ? ` (${th.year})` : ''}`,
                  })),
                },
              ]
            : []),
          { title: t(L.app, lang), tags: r.applications.map((a) => t(a, lang)) },
        ],
        actions: [
          { label: t(L.viewEquip, lang), url: pageUrl(lang, 'facilities'), primary: true },
          { label: t(L.viewMembers, lang), url: pageUrl(lang, 'members') },
        ],
      };

      const thesesModalData: CardModalPayload = {
        icon: '🎓',
        badge: t(r.title, lang),
        title: t(L.thesesTitle, lang),
        desc: t(r.summary, lang),
        sections: [
          {
            title: t(L.thesesTitle, lang),
            cards: (r.theses ?? []).map((th) => ({
              title: t(th.title, lang),
              meta: `${t(th.student, lang)}${th.year ? ` (${th.year})` : ''}`,
            })),
          },
        ],
        actions: [{ label: t(L.viewMembers, lang), url: pageUrl(lang, 'members'), primary: true }],
      };

      return (
        <section class:list={['section', { alt: i % 2 === 1 }]} id={r.id}>
          <div class:list={['container', 'area', { flip: i % 2 === 1 }]}>
            <div>
              <span class="idx">0{i + 1}</span>
              <h2 class="section-title">
                {r.icon} {t(r.title, lang)}
              </h2>
              <p class="lead">{t(r.summary, lang)}</p>
              <h3>{t(L.key, lang)}</h3>
              <ul>
                {r.points.map((p) => (
                  <li>{t(p, lang)}</li>
                ))}
              </ul>
              {r.theses && r.theses.length > 0 && (
                <div class="theses-box card" tabindex="0" role="button" data-card-modal={JSON.stringify(thesesModalData)}>
                  <h3>{t(L.thesesTitle, lang)}</h3>
                  <ul class="theses-list">
                    {r.theses.map((th) => (
                      <li>
                        <span class="th-title">📜 {t(th.title, lang)}</span>
                        <span class="th-author"> — {t(th.student, lang)}{th.year ? ` (${th.year})` : ''}</span>
                      </li>
                    ))}
                  </ul>
                  <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
                </div>
              )}
              <h3>{t(L.app, lang)}</h3>
              <div>
                {r.applications.map((a) => (
                  <span class="tag">{t(a, lang)}</span>
                ))}
              </div>
            </div>
            <div class="card research-media-card" tabindex="0" role="button" data-card-modal={JSON.stringify(areaModalData)}>
              <Img src={r.image} alt={t(r.title, lang)} lang={lang} ratio="4/3" />
              <div class="research-media-foot">
                <span class="research-media-title">{r.icon} {t(r.title, lang)}</span>
                <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .research-media-card {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .research-media-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.15rem;
  }
  .research-media-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--heading);
  }
  .research-media-foot .card-click-hint {
    margin-top: 0.25rem;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    position: relative;
    z-index: 1;
  }
  .jump a {
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .jump a:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .area {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .area.flip > :first-child {
    order: 2;
  }
  @media (max-width: 820px) {
    .area {
      grid-template-columns: 1fr;
    }
    .area.flip > :first-child {
      order: 0;
    }
  }
  .idx {
    font-family: Inter, sans-serif;
    font-weight: 800;
    color: var(--cyan);
    font-size: 1rem;
    letter-spacing: 0.1em;
  }
  .area h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
  }
  .area ul {
    padding-left: 1.2rem;
    margin: 0;
  }
  .area li {
    margin-bottom: 0.4rem;
  }
  .area li::marker {
    color: var(--cyan);
  }
  .lead {
    margin-bottom: 0.5rem;
  }
  .theses-box {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--cyan);
  }
  .theses-box h3 {
    margin: 0 0 0.6rem !important;
    font-size: 0.95rem;
    color: var(--cyan-text);
  }
  .theses-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .theses-list li {
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 0 !important;
    color: var(--text);
  }
  .th-title {
    font-weight: 600;
  }
  .th-author {
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>

