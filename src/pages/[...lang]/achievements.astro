---
import Base from '../../layouts/Base.astro';
import { langPaths, nav, pageUrl, t, ui, withBase, type CardModalPayload, type Lang } from '../../i18n/ui';
import { awards, medalLabel, patentGroups, patentType, publications } from '../../data/achievements';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = t(nav.find((n) => n.page === 'achievements')!.label, lang);
const L = {
  sub: { zh: '國際競賽、全國創新實作、專利與學術發表', en: 'Awards, patents and publications', ja: '国際発明展・コンテスト・特許・論文' },
  awards: { zh: '國內外競賽與國際發明展獲獎 (2010 – 2026)', en: 'Awards & Honors (2010 – 2026)', ja: '受賞歴 (2010 – 2026)' },
  patents: { zh: '專利技術', en: 'Patents', ja: '特許・実用新案' },
  patentListSec: { zh: '本類別所有獲證專利', en: 'Patents in This Category', ja: 'この分野の取得特許一覧' },
  pubs: { zh: '代表性論文發表', en: 'Selected Publications', ja: '主要論文' },
  pubAuthors: { zh: '作者團隊', en: 'Authors', ja: '著者' },
  pubVenue: { zh: '發表期刊／學術會議', en: 'Journal / Conference', ja: '掲載誌・国際会議' },
  openPub: { zh: '前往論文／DOI 頁面', en: 'Open Paper / DOI Link', ja: '論文・DOIページを開く' },
  awardDetailSec: { zh: '獲獎內容與參賽團隊', en: 'Award Details & Team', ja: '受賞詳細・チーム' },
  viewMembers: { zh: '瀏覽實驗室歷屆成員', en: 'View Lab Members & Alumni', ja: 'メンバー・修了生一覧へ' },
  pubsNote: {
    zh: '完整論文列表持續整理更新中。',
    en: 'Full publication list is continuously updated.',
    ja: '論文リストは随時更新中です。',
  },
};
const medalIcon = { gold: '🥇', silver: '🥈', bronze: '🥉', award: '🏆' } as const;
---

<Base lang={lang} page="achievements" title={title}>
  <section class="page-hero">
    <div class="container">
      <h1>{title}</h1>
      <p>{t(L.sub, lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t(L.awards, lang)}</h2>
      <ol class="timeline">
        {
          awards.map((a, idx) => {
            const badgeText = a.badgeLabel ? t(a.badgeLabel, lang) : t(medalLabel[a.medal], lang);
            const modalData: CardModalPayload = {
              icon: medalIcon[a.medal],
              badge: `${a.year} · ${badgeText}`,
              title: t(a.event, lang),
              image: a.image ? withBase(a.image) : undefined,
              desc: a.detail ? t(a.detail, lang) : badgeText,
              sections: a.detail
                ? [{ title: t(L.awardDetailSec, lang), list: [`${a.year} — ${badgeText}`, t(a.detail, lang)] }]
                : [],
              actions: [
                { label: t(ui.openExternalLink, lang), url: a.url, primary: true, external: true },
                { label: t(L.viewMembers, lang), url: pageUrl(lang, 'members') },
              ],
            };
            return (
              <li class={a.medal}>
                <span class="year">{a.year}</span>
                <a class="card award award-link" href={a.url} target="_blank" rel="noopener noreferrer" data-card-modal={JSON.stringify(modalData)}>
                  <span class="medal">{medalIcon[a.medal]}</span>
                  <div class="award-body">
                    <strong>{badgeText}</strong>
                    <p class="event-name">
                      {t(a.event, lang)} <span class="ext-arrow">↗</span>
                    </p>
                    {a.detail && <p class="event-detail">{t(a.detail, lang)}</p>}
                    <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
                  </div>
                  {a.image && (
                    <div class="award-thumb">
                      <img
                        src={withBase(a.image)}
                        alt={t(a.event, lang)}
                        width="260"
                        height="170"
                        loading={idx < 6 ? 'eager' : 'lazy'}
                        fetchpriority={idx < 3 ? 'high' : undefined}
                        decoding="async"
                      />
                    </div>
                  )}
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 class="section-title">{t(L.patents, lang)}</h2>
      <div class="grid grid-3" style="margin-top:1.5rem">
        {
          patentGroups.map((g) => {
            const modalData: CardModalPayload = {
              icon: '📜',
              badge: t(L.patents, lang),
              title: t(g.category, lang),
              desc:
                lang === 'zh'
                  ? `本實驗室於「${t(g.category, 'zh')}」領域共取得 ${g.patents.length} 項中華民國專利。`
                  : lang === 'en'
                    ? `Total of ${g.patents.length} R.O.C. patents granted in ${t(g.category, 'en')}.`
                    : `「${t(g.category, 'ja')}」分野で計 ${g.patents.length} 件の特許・実用新案を取得しています。`,
              sections: [
                {
                  title: t(L.patentListSec, lang),
                  cards: g.patents.map((p) => ({
                    title: t(p.title, lang),
                    badge: t(patentType[p.type], lang),
                  })),
                },
              ],
            };
            return (
              <div class="card card-interactive" tabindex="0" role="button" data-card-modal={JSON.stringify(modalData)}>
                <h3>{t(g.category, lang)}</h3>
                <ul class="plist">
                  {g.patents.map((p) => (
                    <li>
                      <span class:list={['ptype', p.type]}>{t(patentType[p.type], lang)}</span>
                      {t(p.title, lang)}
                    </li>
                  ))}
                </ul>
                <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t(L.pubs, lang)}</h2>
      <ol class="pubs">
        {
          publications.map((p) => {
            const modalData: CardModalPayload = {
              icon: '📄',
              badge: String(p.year),
              title: p.title,
              subtitle: p.venue,
              sections: [
                {
                  title: t(L.pubAuthors, lang),
                  list: [p.authors],
                },
                {
                  title: t(L.pubVenue, lang),
                  list: [`${p.venue} (${p.year})`],
                },
              ],
              actions: [{ label: t(L.openPub, lang), url: p.url, primary: true, external: true }],
            };
            return (
              <li class="pub-card-row" tabindex="0" role="button" data-card-modal={JSON.stringify(modalData)}>
                <span class="pyear">{p.year}</span>
                <div class="pub-row-body">
                  <strong>
                    <span class="pub-title-link">{p.title} ↗</span>
                  </strong>
                  <p>
                    {p.authors} — <em>{p.venue}</em>
                  </p>
                  <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="notice">{t(L.pubsNote, lang)}</p>
    </div>
  </section>
</Base>

<style>
  .card-interactive {
    display: flex;
    flex-direction: column;
  }
  .card-interactive .card-click-hint {
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .pub-card-row {
    border-radius: 10px;
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .pub-card-row:hover {
    background: var(--cyan-soft);
  }
  .pub-row-body {
    flex: 1;
    min-width: 0;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 3.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line-strong);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(3.5rem - 6px);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    border: 3px solid var(--card-bg);
    box-shadow: 0 0 0 2px var(--c);
  }
  .gold {
    --c: var(--gold);
  }
  .silver {
    --c: var(--silver);
  }
  .bronze {
    --c: var(--bronze);
  }
  .award {
    --c: var(--award);
  }
  .year {
    font-family: Inter, sans-serif;
    font-weight: 800;
    color: var(--heading);
  }
  .card.award {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--c);
  }
  .award-link {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .award-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  .award-link:hover .event-name {
    color: var(--cyan-text);
  }
  .award-body {
    flex: 1;
    min-width: 0;
  }
  .award-thumb {
    width: 130px;
    height: 85px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .award-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .award-link:hover .award-thumb img {
    transform: scale(1.06);
  }
  @media (max-width: 680px) {
    .award-thumb {
      display: none;
    }
  }
  .ext-arrow {
    color: var(--cyan-text);
    font-size: 0.9em;
  }
  .event-name {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--text);
  }
  .event-detail {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .medal {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .plist {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plist li {
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--line);
  }
  .plist li:last-child {
    border: 0;
  }
  .ptype {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.05rem 0.5rem;
    border-radius: 6px;
    margin-right: 0.4rem;
    vertical-align: 2px;
  }
  .ptype.invention {
    background: var(--navy);
    color: #fff;
  }
  .ptype.utility {
    background: var(--cyan-soft);
    color: var(--cyan-text);
  }
  .pubs {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }
  .pubs li {
    display: flex;
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .pubs p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .pyear {
    font-family: Inter, sans-serif;
    font-weight: 800;
    color: var(--cyan-text);
  }
  .pub-title-link {
    color: var(--heading);
    text-decoration: none;
    transition: color 0.2s;
  }
  .pub-title-link:hover {
    color: var(--cyan-text);
    text-decoration: underline;
  }
</style>
