---
import Base from '../../layouts/Base.astro';
import { langPaths, nav, pageUrl, t, ui, type CardModalPayload, type Lang } from '../../i18n/ui';
import { lab, pi } from '../../data/lab';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = t(nav.find((n) => n.page === 'contact')!.label, lang);
const L = {
  sub: { zh: '歡迎參觀、加入或洽談合作', en: 'Visit, join, or collaborate with us', ja: '見学・参加・共同研究のご相談' },
  info: { zh: '聯絡資訊', en: 'Contact Information', ja: '連絡先' },
  lab: { zh: '實驗室', en: 'Lab', ja: '研究室' },
  addr: { zh: '地址', en: 'Address', ja: '住所' },
  phone: { zh: '電話', en: 'Phone', ja: '電話' },
  join: { zh: '加入我們', en: 'Join Us', ja: '研究室に参加' },
  who: { zh: '適合對象', en: 'Who should apply', ja: '対象' },
  whoList: [
    {
      zh: '對半導體元件、LED 封裝、光電材料有興趣的同學',
      en: 'Students interested in semiconductor devices, LED packaging, optoelectronic materials',
      ja: '半導体デバイス・LEDパッケージング・光電子材料に興味のある学生',
    },
    {
      zh: '喜歡動手做量測系統、寫 LabVIEW / 程式的同學',
      en: 'Students who enjoy building measurement systems and coding (LabVIEW, etc.)',
      ja: '計測システム作りやプログラミング（LabVIEW等）が好きな学生',
    },
    {
      zh: '大三、大四專題生與碩士班報考生',
      en: 'Junior/senior undergraduates and prospective M.S. students',
      ja: '学部3・4年生および修士課程志望者',
    },
  ],
  whoDesc: {
    zh: '歡迎對電子量測、半導體製程、光電元件設計與嵌入式 AIoT 懷抱熱忱的同學預約參觀 ATC 0102，與指導教授及學長姐面對面討論專題與研究規劃。',
    en: 'Motivated undergraduate and prospective M.S. students interested in metrology, semiconductors, optoelectronics, or AIoT are welcome to visit ATC 0102 and meet Prof. Chen and current students.',
    ja: '電子計測・半導体プロセス・光電デバイス・AIoTに関心のある学部生・大学院志望者の研究室見学（ATC 0102）や面談を随時受け付けています。',
  },
  whoProcess: [
    { zh: '① 先透過 Email 或於系辦／研究室時間與陳文瑞教授預約面談。', en: '① Email Prof. Wen-Ray Chen or schedule an office-hour chat.', ja: '① メール等で陳文瑞教授との面談を予約。' },
    { zh: '② 參觀 ATC 0102 量測與製程機台，了解感興趣的研究組別。', en: '② Tour ATC 0102 facilities and meet senior lab members.', ja: '② ATC 0102の設備見学と先輩学生との懇談。' },
    { zh: '③ 大學部可從基礎儀器認證與專題實作起步，碩士班深入研發與競賽發表。', en: '③ Start with core instrumentation & projects; advance to research & conferences in M.S.', ja: '③ 学部生は基礎実習からスタートし、修士課程で先端研究・学会発表へ発展。' },
  ],
  gain: { zh: '你會學到', en: 'What you will learn', ja: '身につくこと' },
  gainList: [
    { zh: '精密電子/光電量測儀器操作', en: 'Operating precision electronic & optical instruments', ja: '精密電子・光学計測機器の操作' },
    { zh: '半導體薄膜製程與分析', en: 'Thin-film fabrication and analysis', ja: '半導体薄膜の作製と解析' },
    { zh: '產學合作專案經驗', en: 'Industry project experience', ja: '産学連携プロジェクトの経験' },
    { zh: '國際發明展參賽機會', en: 'Chances to compete in international invention shows', ja: '国際発明展への出展機会' },
  ],
  gainDesc: {
    zh: '實驗室兼顧元件物理實務與系統整合實作能力，讓每位成員都能累積具產業競爭力的研發經歷與實戰作品集。',
    en: 'The lab balances hands-on device physics with system integration skills, building an industry-ready portfolio of real prototypes and publications.',
    ja: 'デバイス物性とシステム統合の実践力をバランスよく身につけ、産業界で通用する研究開発実績を積むことができます。',
  },
  gainDetails: [
    { zh: '儀器實操：微探針量測台、大小型積分球光譜系統、BK 高速示波器、熱蒸鍍與磁控濺鍍系統。', en: 'Instrumentation: Micro-probe station, integrating spheres, BK oscilloscopes, thermal & sputter coaters.', ja: '主要機器：プローブ台、各種積分球、高速オシロ、真空蒸着・スパッタ装置。' },
    { zh: '軟體與開發：LabVIEW 自動量測控制、ESP32 / Python AIoT 韌體、SolidWorks / Fusion 360 治具與 3D 列印。', en: 'Software & Dev: LabVIEW automation, ESP32/Python AIoT firmware, CAD & 3D prototyping.', ja: '開発技術：LabVIEW自動計測、ESP32/Python AIoT開発、CAD設計・3D造形。' },
    { zh: '成果展現：國內外期刊論文發表、IEEE 國際研討會口頭／海報報告、TIE 與全國大賽實機參展。', en: 'Outcomes: SCI journals, IEEE international conferences, TIE & national competitions.', ja: '実績展開：国際学術誌、IEEE国際学会発表、TIE国際発明展・全国コンテスト出展。' },
  ],
  collab: { zh: '產學合作', en: 'Industry Collaboration', ja: '産学連携' },
  collabText: {
    zh: '本實驗室在 LED 封裝、散熱設計、光電檢測與自動化量測系統具備豐富經驗，歡迎企業來信洽談技術合作或委託量測。',
    en: 'With expertise in LED packaging, thermal design, optoelectronic inspection and automated measurement, we welcome industry partners for collaboration or testing services.',
    ja: 'LEDパッケージング、放熱設計、光電子検査、自動計測システムの豊富な経験を活かし、企業との共同研究や計測受託のご相談を歓迎します。',
  },
  mail: { zh: '寄信給我們', en: 'Email us', ja: 'メールを送る' },
  openMaps: { zh: '在 Google 地圖開啟', en: 'Open in Maps', ja: 'Googleマップで開く' },
  secDetail: { zh: '詳細地點與聯絡管道', en: 'Location & Contact Channels', ja: '所在地・連絡窓口' },
  secProcess: { zh: '申請與加入流程', en: 'How to Join', ja: '配属・参加の流れ' },
  secSkills: { zh: '核心訓練項目', en: 'Core Training Highlights', ja: '育成スキル詳細' },
  viewResearch: { zh: '瀏覽研究領域', en: 'Explore Research Areas', ja: '研究分野を見る' },
  viewFacilities: { zh: '查看設備與規範', en: 'View Equipment & Rules', ja: '設備・規則を見る' },
};
---

<Base lang={lang} page="contact" title={title}>
  <section class="page-hero">
    <div class="container">
      <h1>{title}</h1>
      <p>{t(L.sub, lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div
        class="card"
        tabindex="0"
        role="button"
        data-card-modal={JSON.stringify({
          icon: '🏢',
          badge: t(L.info, lang),
          title: t(lab.name, lang),
          subtitle: t(lab.location, lang),
          desc: t(lab.intro, lang),
          sections: [
            {
              title: t(L.secDetail, lang),
              list: [
                `${t(L.lab, lang)}：${t(lab.location, lang)}`,
                `${t(L.addr, lang)}：${t(lab.address, lang)}`,
                `${t(L.phone, lang)}：${pi.phoneLab} / ${pi.phoneOffice}`,
                `Email：${pi.email}`,
                t(pi.office, lang),
              ],
            },
          ],
          actions: [
            { label: `✉️ ${t(L.mail, lang)}`, url: `mailto:${pi.email}`, primary: true, contactEmail: true },
            { label: `📍 ${t(L.openMaps, lang)}`, url: 'https://maps.app.goo.gl/H6PMFg5xk6Nzutm77', external: true },
          ],
        } satisfies CardModalPayload)}
      >
        <h2 class="section-title">{t(L.info, lang)}</h2>
        <dl>
          <dt>{t(L.lab, lang)}</dt>
          <dd>{t(lab.location, lang)}</dd>
          <dt>{t(L.addr, lang)}</dt>
          <dd>
            <a href="https://maps.app.goo.gl/H6PMFg5xk6Nzutm77" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline dotted;" title={lang === 'zh' ? '在 Google 地圖中查看' : 'View on Google Maps'}>
              {t(lab.address, lang)} 📍
            </a>
          </dd>
          <dt>{t(L.phone, lang)}</dt>
          <dd>{pi.phoneLab} / {pi.phoneOffice}</dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${pi.email}`} data-contact-email-trigger>{pi.email}</a></dd>
        </dl>
        <div class="contact-card-footer">
          <button type="button" class="btn btn-primary" id="btn-mail-us" data-contact-email-trigger>✉️ {t(L.mail, lang)}</button>
          <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
        </div>
      </div>

      <div class="card map-card">
        <div class="map-card-head">
          <div class="map-card-title">
            <span aria-hidden="true">📍</span>
            <span>{t({ zh: '國立虎尾科技大學 第一校區 第三教學大樓', en: 'National Formosa University — Academic Building III', ja: '国立虎尾科技大学 第一キャンパス 第三教育研究棟' }, lang)}</span>
          </div>
          <a
            class="map-direct-link"
            href="https://maps.app.goo.gl/H6PMFg5xk6Nzutm77"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t({ zh: '在 Google 地圖開啟 ↗', en: 'Open in Maps ↗', ja: 'Googleマップで開く ↗' }, lang)}
          </a>
        </div>
        <iframe
          class="map"
          title="Google Maps"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1829.435!2d120.4294992!3d23.7034663!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346eba0752c36acd%3A0xf39a22e7ad517f7f!2z56ys5LiJ5pWZ5a245aSn5qiT!5e0!3m2!1szh-TW!2stw!4v1700000000000!5m2!1szh-TW!2stw"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section alt" id="join">
    <div class="container">
      <h2 class="section-title">{t(L.join, lang)}</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <div
          class="card card-interactive"
          tabindex="0"
          role="button"
          data-card-modal={JSON.stringify({
            icon: '🎯',
            badge: t(L.join, lang),
            title: t(L.who, lang),
            desc: t(L.whoDesc, lang),
            sections: [
              { title: t(L.who, lang), list: L.whoList.map((x) => t(x, lang)) },
              { title: t(L.secProcess, lang), list: L.whoProcess.map((x) => t(x, lang)) },
            ],
            actions: [
              { label: `✉️ ${t(L.mail, lang)}`, url: `mailto:${pi.email}`, primary: true, contactEmail: true },
              { label: t(L.viewResearch, lang), url: pageUrl(lang, 'research') },
            ],
          } satisfies CardModalPayload)}
        >
          <h3>🎯 {t(L.who, lang)}</h3>
          <ul>{L.whoList.map((x) => <li>{t(x, lang)}</li>)}</ul>
          <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
        </div>
        <div
          class="card card-interactive"
          tabindex="0"
          role="button"
          data-card-modal={JSON.stringify({
            icon: '🚀',
            badge: t(L.join, lang),
            title: t(L.gain, lang),
            desc: t(L.gainDesc, lang),
            sections: [
              { title: t(L.gain, lang), list: L.gainList.map((x) => t(x, lang)) },
              { title: t(L.secSkills, lang), list: L.gainDetails.map((x) => t(x, lang)) },
            ],
            actions: [
              { label: t(L.viewFacilities, lang), url: pageUrl(lang, 'facilities'), primary: true },
              { label: t(L.viewResearch, lang), url: pageUrl(lang, 'research') },
            ],
          } satisfies CardModalPayload)}
        >
          <h3>🚀 {t(L.gain, lang)}</h3>
          <ul>{L.gainList.map((x) => <li>{t(x, lang)}</li>)}</ul>
          <span class="card-click-hint">{t(ui.viewDetails, lang)} →</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="collab">
    <div class="container">
      <h2 class="section-title">{t(L.collab, lang)}</h2>
      <p class="lead">{t(L.collabText, lang)}</p>
    </div>
  </section>
</Base>

<style>
  .contact-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .contact-card-footer .card-click-hint {
    margin-top: 0;
  }
  .card-interactive {
    display: flex;
    flex-direction: column;
  }
  .card-interactive .card-click-hint {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  dl {
    margin: 1rem 0 1.5rem;
  }
  dt {
    font-weight: 700;
    color: var(--heading);
    margin-top: 0.75rem;
  }
  dd {
    margin: 0.15rem 0 0;
  }
  .map-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .map-card-head {
    padding: 0.85rem 1.15rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: var(--bg-alt);
    font-size: 0.88rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .map-card-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--heading);
  }
  .map-direct-link {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    color: var(--cyan);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .map-direct-link:hover {
    border-color: var(--cyan);
    background: var(--cyan-soft);
  }
  .map {
    width: 100%;
    min-height: 380px;
    flex: 1;
    border: 0;
    display: block;
  }
  ul {
    padding-left: 1.2rem;
  }
  li::marker {
    color: var(--cyan);
  }
</style>

