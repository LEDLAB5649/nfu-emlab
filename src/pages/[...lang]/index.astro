---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { langPaths, pageUrl, t, ui, withBase, type CardModalPayload, type Lang } from '../../i18n/ui';
import { lab } from '../../data/lab';
import { research } from '../../data/research';
import { awards, medalLabel, patentGroups, patentType, publications } from '../../data/achievements';
import { news } from '../../data/facilities';
import { alumni, graduatedMsMembers } from '../../data/members';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };

const golds = awards.filter((a) => a.medal === 'gold').length;
const silvers = awards.filter((a) => a.medal === 'silver').length;
const bronzes = awards.filter((a) => a.medal === 'bronze').length;
const otherAwards = awards.length - golds - silvers - bronzes;
const patentCount = patentGroups.reduce((n, g) => n + g.patents.length, 0);
const stats = [
  {
    value: `${awards.length}+`,
    label: { zh: '國內外競賽與發明獎項', en: 'Invention & Innovation Awards', ja: '国内外受賞歴' },
    modal: {
      icon: '🏆',
      badge: { zh: '實驗室榮譽紀錄', en: 'Lab Honors', ja: '受賞実績' },
      desc: {
        zh: `電子量測實驗室自 2010 年至 2026 年間，於英國倫敦、韓國首爾、馬來西亞 ITEX、台灣創新技術博覽會 (TIE)、IEEE 國際研討會及全國大專院校產學創新實作競賽累積超過 ${awards.length} 項獎項。`,
        en: `From 2010 to 2026, our lab has earned over ${awards.length} honors across London, Seoul SIIF, Malaysia ITEX, Taiwan Innotech Expo (TIE), IEEE conferences, and national competitions.`,
        ja: `2010年から2026年にかけて、ロンドン・ソウル・マレーシアITEX・TIE・IEEE国際会議・全国大会で${awards.length}件以上の賞を受賞しています。`,
      },
      list: [
        { zh: `金牌／最佳論文首獎：${golds} 項`, en: `Gold / Best Paper Awards: ${golds}`, ja: `金賞・最優秀賞：${golds}件` },
        { zh: `銀牌獎：${silvers} 項`, en: `Silver Medals: ${silvers}`, ja: `銀賞：${silvers}件` },
        { zh: `銅牌／第三名：${bronzes} 項`, en: `Bronze Medals / 3rd Place: ${bronzes}`, ja: `銅賞・第3位：${bronzes}件` },
        { zh: `創新設計與佳作等獎項：${otherAwards} 項`, en: `Innovation & Honorable Mention Awards: ${otherAwards}`, ja: `革新賞・佳作など：${otherAwards}件` },
      ],
      actionUrl: pageUrl(lang, 'achievements'),
      actionLabel: { zh: '前往研究成果查看完整獲獎名單', en: 'View Full Awards Timeline', ja: '受賞歴一覧を見る' },
    },
  },
  {
    value: `${golds}`,
    label: { zh: '國際金牌／首獎', en: 'Gold / Best Paper Awards', ja: '国際金賞・最優秀賞' },
    modal: {
      icon: '🥇',
      badge: { zh: '最高榮譽紀錄', en: 'Top Honors', ja: '最高賞実績' },
      desc: {
        zh: '包含國際學術研討會最佳論文／壁報獎及世界三大國際發明展金牌殊榮：',
        en: 'Includes Best Student Poster Awards at international conferences and Gold Medals at major invention exhibitions:',
        ja: '国際学会最優秀賞および国際発明展金賞の受賞記録：',
      },
      list: awards
        .filter((a) => a.medal === 'gold')
        .map((a) => ({
          zh: `[${a.year}] ${t(a.event, 'zh')}${a.detail ? ` — ${t(a.detail, 'zh')}` : ''}`,
          en: `[${a.year}] ${t(a.event, 'en')}${a.detail ? ` — ${t(a.detail, 'en')}` : ''}`,
          ja: `[${a.year}] ${t(a.event, 'ja')}${a.detail ? ` — ${t(a.detail, 'ja')}` : ''}`,
        })),
      actionUrl: pageUrl(lang, 'achievements'),
      actionLabel: { zh: '查看所有得獎紀錄與新聞公告', en: 'View All Awards', ja: '受賞記録をすべて見る' },
    },
  },
  {
    value: `${patentCount}+`,
    label: { zh: '專利技術', en: 'Patents', ja: '特許・実用新案' },
    modal: {
      icon: '📜',
      badge: { zh: '智慧財產成果', en: 'Intellectual Property', ja: '知的財産実績' },
      desc: {
        zh: `指導教授陳文瑞帶領實驗室團隊研發獲得共 ${patentCount} 項中華民國發明專利與新型專利，橫跨工業量測、光電照明與生醫民生電子三大領域。`,
        en: `Prof. Wen-Ray Chen and lab teams hold ${patentCount} R.O.C. invention and utility model patents across industrial metrology, optoelectronics lighting, and biomedical devices.`,
        ja: `陳文瑞教授と研究室メンバーにより取得された中華民国特許・実用新案 ${patentCount}件の分野別内訳：`,
      },
      list: patentGroups.map((g) => ({
        zh: `${t(g.category, 'zh')}（${g.patents.length} 項）：${g.patents.map((p) => t(p.title, 'zh')).join('、')}`,
        en: `${t(g.category, 'en')} (${g.patents.length}): ${g.patents.map((p) => t(p.title, 'en')).join('; ')}`,
        ja: `${t(g.category, 'ja')}（${g.patents.length}件）：${g.patents.map((p) => t(p.title, 'ja')).join('、')}`,
      })),
      actionUrl: pageUrl(lang, 'achievements'),
      actionLabel: { zh: '查看完整專利分類列表', en: 'View All Patents', ja: '特許一覧を見る' },
    },
  },
  {
    value: `${alumni.length}+`,
    label: { zh: '歷屆培育人才', en: 'Graduates & Alumni', ja: '輩出人材・修了生' },
    modal: {
      icon: '🎓',
      badge: { zh: '人才培育成果', en: 'Talent Cultivation', ja: '人材育成実績' },
      desc: {
        zh: `自 2008 年至 2026 年累計培育超過 ${alumni.length} 位碩士班畢業生與大學部專題實作／國際競賽得獎學生，校友遍佈台灣各大半導體、光電與科技企業。`,
        en: `Since 2008, our lab has trained over ${alumni.length} Master’s graduates and award-winning undergraduates now working across Taiwan’s semiconductor and high-tech industries.`,
        ja: `2008年から2026年までに${alumni.length}名以上の大学院修了生・卒業研究学生を輩出し、半導体・光電子産業で活躍しています。`,
      },
      list: [
        {
          zh: `歷屆畢業碩士生（電子所／光電材料所）：${graduatedMsMembers.length} 位（均可於成員頁點選查看碩士論文）`,
          en: `Graduated M.S. Students (EE / Optoelectronics): ${graduatedMsMembers.length} (Full profiles & theses on Members page)`,
          ja: `歴代修士課程修了生：${graduatedMsMembers.length}名（メンバーページで論文詳細閲覧可能）`,
        },
        {
          zh: `大學部專題生暨國際競賽／TIE 獲獎校友紀錄：${alumni.length - graduatedMsMembers.length} 筆`,
          en: `Undergraduate Research & Competition Alumni Records: ${alumni.length - graduatedMsMembers.length}`,
          ja: `学部卒業研究・国際コンテスト受賞者記録：${alumni.length - graduatedMsMembers.length}件`,
        },
      ],
      actionUrl: pageUrl(lang, 'members'),
      actionLabel: { zh: '前往成員頁面瀏覽完整名單', en: 'Browse Members & Alumni', ja: 'メンバー・修了生一覧へ' },
    },
  },
];
const L = {
  researchTitle: { zh: '研究領域', en: 'Research Areas', ja: '研究分野' },
  researchLead: {
    zh: '橫跨半導體材料、覆晶微接合、智慧物聯網到光電微量測的六大核心研究主軸。',
    en: 'Six core research pillars spanning semiconductor materials, flip-chip micro-bonding, AIoT sensing, and advanced metrology.',
    ja: '半導体材料、フリップチップ実装、スマートAIoTから光電子微細計測まで広がる6つの中核研究領域。',
  },
  joinTitle: { zh: '一起來做研究吧！', en: 'Join our lab!', ja: '一緒に研究しませんか？' },
  pubsTitle: { zh: '代表性論文發表', en: 'Selected Publications', ja: '主要論文' },
  allAchievements: { zh: '查看全部研究成果', en: 'View all achievements', ja: '研究成果をすべて見る' },
  keyTech: { zh: '關鍵技術', en: 'Key Technologies', ja: '主要技術' },
  theses: { zh: '代表學位論文', en: 'Representative Theses', ja: '代表修士論文' },
  apps: { zh: '應用領域', en: 'Applications', ja: '応用分野' },
  openAreaPage: { zh: '前往研究領域專區查看', en: 'Open Research Section', ja: '研究分野セクションを開く' },
  statDetailSec: { zh: '統計明細', en: 'Breakdown', ja: '実績内訳' },
  pubAuthors: { zh: '作者群', en: 'Authors', ja: '著者' },
  pubVenue: { zh: '發表期刊／會議', en: 'Journal / Conference', ja: '掲載誌・会議' },
  joinText: {
    zh: '歡迎對半導體、LED、光電量測與感測系統有興趣的專題生與碩士生加入。',
    en: 'We welcome undergraduate and graduate students interested in semiconductors, LEDs, optoelectronic measurement and sensing.',
    ja: '半導体・LED・光電子計測・センシングに興味のある学部生・大学院生を歓迎します。',
  },
};
---

<Base lang={lang} page="">
  <section class="hero">
    <svg class="wave" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0 120 H180 L210 60 L250 170 L290 40 L320 140 L340 110 H560 L580 90 L600 130 L620 100 H820 L850 30 L890 180 L930 70 L950 120 H1200"
      ></path>
    </svg>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{t(ui.univ, lang)}</p>
        <h1>{t(lab.name, lang)}</h1>
        <p class="tagline">{t(lab.tagline, lang)}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`${pageUrl(lang, 'contact')}#join`}>{t(ui.joinUs, lang)}</a>
          <a class="btn btn-ghost" href={pageUrl(lang, 'research')}>{t(L.researchTitle, lang)}</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-logo-box">
          <div class="hero-logo-halo" aria-hidden="true"></div>
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_hero_static.webp')} type="image/webp" />
            <source media="(prefers-reduced-motion: reduce)" srcset={withBase('/images/logo_hero_static.png')} type="image/png" />
            <source srcset={withBase('/images/logo_hero_animated.webp')} type="image/webp" />
            <img
              src={withBase('/images/logo_hero_animated.gif')}
              alt="NFU LED LAB Logo"
              width="480"
              height="395"
              class="hero-logo-img"
              loading="eager"
            />
          </picture>
          <div class="hero-logo-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            <strong>NFU LED LAB</strong>
            <span class="badge-sep">·</span>
            <span>ATC 0102</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container stats-grid">
      {
        stats.map((s) => {
          const modalData: CardModalPayload = {
            icon: s.modal.icon,
            badge: t(s.modal.badge, lang),
            title: `${s.value} — ${t(s.label, lang)}`,
            desc: t(s.modal.desc, lang),
            sections: [
              {
                title: t(L.statDetailSec, lang),
                list: s.modal.list.map((item) => t(item, lang)),
              },
            ],
            actions: [{ label: t(s.modal.actionLabel, lang), url: s.modal.actionUrl, primary: true }],
          };
          return (
            <div class="stat" tabindex="0" role="button" data-card-modal={JSON.stringify(modalData)}>
              <strong>{s.value}</strong>
              <span>{t(s.label, lang)}</span>
              <small class="stat-hint">{t(ui.viewDetails, lang)} →</small>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t(L.researchTitle, lang)}</h2>
      <p class="lead">{t(L.researchLead, lang)}</p>
      <div class="grid grid-3">
        {
          research.map((r) => {
            const modalData: CardModalPayload = {
              icon: r.icon,
              badge: t(L.researchTitle, lang),
              title: t(r.title, lang),
              image: withBase(r.image),
              desc: t(r.summary, lang),
              sections: [
                { title: t(L.keyTech, lang), list: r.points.map((pt) => t(pt, lang)) },
                ...(r.theses?.length
                  ? [
                      {
                        title: t(L.theses, lang),
                        cards: r.theses.map((th) => ({
                          title: t(th.title, lang),
                          meta: `${t(th.student, lang)}${th.year ? ` (${th.year})` : ''}`,
                        })),
                      },
                    ]
                  : []),
                { title: t(L.apps, lang), tags: r.applications.map((a) => t(a, lang)) },
              ],
              actions: [{ label: t(L.openAreaPage, lang), url: `${pageUrl(lang, 'research')}#${r.id}`, primary: true }],
            };
            return (
              <a class="card" href={`${pageUrl(lang, 'research')}#${r.id}`} data-card-modal={JSON.stringify(modalData)}>
                <Img src={r.image} alt={t(r.title, lang)} lang={lang} ratio="16/10" />
                <h3>
                  {r.icon} {t(r.title, lang)}
                </h3>
                <p>{t(r.summary, lang)}</p>
                <span class="more">{t(ui.viewDetails, lang)} →</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container grid grid-2">
      <div>
        <h2 class="section-title">{t(ui.latestNews, lang)}</h2>
        <ul class="news-list">
          {
            news.slice(0, 3).map((n) => {
              const modalData: CardModalPayload = {
                title: t(n.title, lang),
                badge: n.date,
                image: n.image ? withBase(n.image) : undefined,
                desc: n.body ? t(n.body, lang) : t(n.title, lang),
                actions: [
                  ...(n.url ? [{ label: t(ui.openExternalLink, lang), url: n.url, primary: true, external: true }] : []),
                  { label: t(ui.allNews, lang), url: pageUrl(lang, 'news'), primary: !n.url },
                ],
              };
              return (
                <li tabindex="0" role="button" data-card-modal={JSON.stringify(modalData)}>
                  <time>{n.date}</time>
                  <span>
                    <span class={n.url ? 'pub-link' : undefined}>
                      {t(n.title, lang)}
                      {n.url ? ' ↗' : ''}
                    </span>
                  </span>
                </li>
              );
            })
          }
        </ul>
        <a href={pageUrl(lang, 'news')}>{t(ui.allNews, lang)} →</a>
      </div>
      <div>
        <h2 class="section-title">{t(L.pubsTitle, lang)}</h2>
        <ul class="news-list">
          {
            publications.slice(0, 3).map((p) => {
              const modalData: CardModalPayload = {
                icon: '📄',
                badge: String(p.year),
                title: p.title,
                subtitle: p.venue,
                sections: [
                  { title: t(L.pubAuthors, lang), list: [p.authors] },
                  { title: t(L.pubVenue, lang), list: [`${p.venue} (${p.year})`] },
                ],
                actions: [
                  { label: t(ui.openExternalLink, lang), url: p.url, primary: true, external: true },
                  { label: t(L.allAchievements, lang), url: pageUrl(lang, 'achievements') },
                ],
              };
              return (
                <li tabindex="0" role="button" data-card-modal={JSON.stringify(modalData)}>
                  <time>{p.year}</time>
                  <span>
                    <span class="pub-link">{p.title} ↗</span> <em>— {p.venue}</em>
                  </span>
                </li>
              );
            })
          }
        </ul>
        <a href={pageUrl(lang, 'achievements')}>{t(L.allAchievements, lang)} →</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <h2>{t(L.joinTitle, lang)}</h2>
        <p>{t(L.joinText, lang)}</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${pageUrl(lang, 'contact')}#join`}>{t(ui.joinUs, lang)}</a>
        <a class="btn btn-ghost" href={`${pageUrl(lang, 'contact')}#collab`}>{t(ui.collab, lang)}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(circle at 82% 22%, rgba(19, 196, 217, 0.28) 0%, transparent 42%),
      radial-gradient(circle at 18% 80%, rgba(59, 130, 246, 0.24) 0%, transparent 48%),
      linear-gradient(135deg, #06152d 0%, var(--navy) 52%, #163e73 100%);
    color: #fff;
    overflow: hidden;
    padding: 5.25rem 0 6.25rem;
    border-bottom: 1px solid rgba(34, 211, 238, 0.22);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(34, 211, 238, 0.28) 1px, transparent 0),
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size:
      128px 128px,
      32px 32px,
      32px 32px;
    mask-image: radial-gradient(ellipse 85% 80% at 55% 45%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 55% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }
  .wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    width: 100%;
    height: 160px;
    opacity: 0.35;
  }
  .wave path {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 2.5;
    stroke-dasharray: 2600;
    stroke-dashoffset: 2600;
    animation: draw 4s ease-out forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .eyebrow {
    color: var(--cyan);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin: 0.4rem 0 1rem;
    font-weight: 900;
  }
  .tagline {
    font-size: 1.15rem;
    color: #c8d6e8;
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .hero-media {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .hero-logo-box {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .hero-logo-halo {
    position: absolute;
    inset: -15px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgba(19, 196, 217, 0.35), rgba(59, 130, 246, 0.18) 45%, transparent 70%);
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
    animation: haloPulse 4s ease-in-out infinite alternate;
  }
  @keyframes haloPulse {
    0% {
      opacity: 0.6;
      transform: scale(0.94);
    }
    100% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  .hero-logo-img {
    width: 100%;
    max-width: 440px;
    height: auto;
    aspect-ratio: 1024 / 842;
    display: block;
    object-fit: contain;
    background: transparent;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 24px rgba(34, 211, 238, 0.4));
    transition: transform 0.3s ease, filter 0.3s ease;
  }
  .hero-logo-box:hover .hero-logo-img {
    transform: scale(1.03);
    filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 35px rgba(34, 211, 238, 0.65));
  }
  .hero-logo-badge {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.15rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: livePulse 2s ease-in-out infinite;
  }
  @keyframes livePulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }
  .badge-sep {
    color: #94a3b8;
  }
  @media (max-width: 820px) {
    .hero-inner {
